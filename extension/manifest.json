{
  "manifest_version": 3,
  "name": "Sidebar Peek",
  "version": "1.6.0",
  "description": "Hover a channel in the Twitch sidebar to see a small live preview of the stream before you open it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Sidebar Peek settings",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "js": [
        "settings.js",
        "player-gate.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "short_name": "Sidebar Peek"
}